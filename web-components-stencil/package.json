{
  "name": "web-components-stencil",
  "version": "0.0.1",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/web-components-stencil/web-components-stencil.esm.js",
  "exports": {
    ".": {
      "import": "./dist/web-components-stencil/web-components-stencil.esm.js",
      "require": "./dist/web-components-stencil/web-components-stencil.cjs.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./design-tokens": {
      "import": "./dist/design-tokens.js",
      "types": "./dist/design-tokens.d.ts"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stenciljs/component-starter.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "storybook": "npm run build && concurrently -k \"stencil build --watch --dev\" \"storybook dev -p 6006\"",
    "storybook:build": "npm run build && storybook build",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:preview": "npm run pages:build && python3 -m http.server 4173 -d docs",
    "test": "stencil-test",
    "test:watch": "stencil-test --watch",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1",
    "@stencil/vitest": "^1.8.3",
    "@storybook/addon-essentials": "^7.6.20",
    "@storybook/web-components": "^7.6.20",
    "@storybook/web-components-vite": "^7.6.20",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "concurrently": "^9.1.2",
    "storybook": "^7.6.20",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
